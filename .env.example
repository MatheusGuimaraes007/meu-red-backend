# Local default. In production, the server uses the PORT provided by Render.
PORT=3000
CORS_ORIGINS=http://localhost:5173,https://crm-red-front.vercel.app
# Runtime: copy the Transaction pooler URL from Supabase > Connect.
# The username must be postgres.PROJECT_REF (not only postgres).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
SUPABASE_POOLER_HOST=aws-1-us-east-1.pooler.supabase.com
# Migrations/introspection: copy the Direct connection URL from Supabase > Connect.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
MASTER_ADMIN_EMAIL=admin@example.com
MASTER_ADMIN_PASSWORD=replace-on-first-start
W_API_BASE_URL=https://api.w-api.app
# Chave global do painel do provedor. Necessária para criar, excluir e sincronizar instâncias.
# Rotas de status, QR Code, fila, mídia e desconexão usam o token salvo da própria instância.
W_API_API_KEY=replace-with-your-provider-panel-key
W_API_WEBHOOK_BASE_URL=https://your-render-service.onrender.com
WHATSAPP_WEBHOOK_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-backend-only-service-role-key
SUPABASE_STORAGE_BUCKET_CHAT_MEDIA=chat-media
MEDIA_SIGNED_URL_TTL_SECONDS=3600
MEDIA_MAX_FILE_SIZE_BYTES=52428800
MEDIA_DOWNLOAD_TIMEOUT_MS=30000
